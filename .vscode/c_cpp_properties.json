{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/external"
            ],
            "defines": [
                "VK_USE_PLATFORM_XLIB_KHR=1"
            ],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64"
        },
        {
            "name": "Windows",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/external"
            ],
            "defines": [
                "VK_USE_PLATFORM_WIN32_KHR=1",
                "WIN32_LEAN_AND_MEAN=1",
                "_WIN32_WINNT=0x0602"
            ],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-x64"
        }
    ],
    "version": 4
}